ARG BASE_IMAGE=lasaa-demo
FROM ${BASE_IMAGE}

# httpx is needed only by the tests (FastAPI's TestClient).
RUN pip install fastapi uvicorn jinja2 python-multipart markdown-it-py pygments httpx

# The unprivileged user that builds run as (lasaa_webui/snapshot.py,
# BUILD_UID).  Builds work without this account; it gives the uid a name.
RUN groupadd --system --gid 65532 lasaa-build \
    && useradd --system --uid 65532 --gid 65532 --no-create-home \
               --home-dir /nonexistent --shell /usr/sbin/nologin lasaa-build
