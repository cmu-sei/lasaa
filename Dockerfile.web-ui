###################################################################
#
# Image for the LASAA web UI (code/lasaa_webui/): adds the web server's
# Python packages to the demo image, which already has the analyzers
# (Clang Static Analyzer and Cppcheck) that the UI runs.
#
# To build (if the demo image is tagged "lasaa-demo"):
#   docker build -f Dockerfile.web-ui -t lasaa-web-ui .
#
# To build on a different image (e.g., the base "lasaa" image, for
# browsing existing results without running analyzers):
#   docker build -f Dockerfile.web-ui --build-arg BASE_IMAGE=<tag> -t lasaa-web-ui .
#
# To run, see code/lasaa_webui/README.md (it publishes the port on the
# host's loopback interface only, and mounts the code read-only).
#
###################################################################
# <legal>
# LASAA tool
#
