###################################################################
#
# Image for the tinykv demo (examples/tinykv): adds Clang Static
# Analyzer (scan-build) and Cppcheck to the base LASAA image.
#
# To build (if base image is tagged "lasaa"):
#   docker build -f Dockerfile.demo -t lasaa-demo .

# To build (if base image has a different tag):
#   docker build -f Dockerfile.demo --build-arg BASE_IMAGE=<base-tag> -t lasaa-demo .
#
# To run:
#   docker run -it --rm -v ${PWD}:/host -w /host lasaa-demo bash
#
###################################################################
# <legal>
# LASAA tool
