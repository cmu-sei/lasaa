ARG BASE_IMAGE=lasaa
FROM ${BASE_IMAGE}

# Clang and scan-build (large; split out from the base image), and Cppcheck
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get -y install --no-install-recommends \
         clang clang-tools cppcheck \
    && apt-get --purge -y autoremove \
    && apt-get clean
